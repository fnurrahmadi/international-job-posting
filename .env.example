# Use the pooled connection string for the web app and ingestion worker.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional: limits concurrent company fetches during ingestion.
INGEST_CONCURRENCY=4

# Optional: config/companies.json by default.
COMPANIES_CONFIG=config/companies.json

# Optional saved-search email delivery via Resend's free tier.
RESEND_API_KEY=
ALERT_FROM_EMAIL=Relocate Jobs <jobs@your-verified-domain.com>
APP_BASE_URL=http://localhost:3000
